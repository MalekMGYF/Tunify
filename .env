# --- Database ---
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres.xyhwehggxazvfeiukcjn:MLMLMKMK123%24a@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# --- Sessions ---
# Long, random secret used to sign admin session tokens (httpOnly cookie).
# Generate one with: openssl rand -base64 48
SESSION_SECRET="Mlmlmkmk123$"

# --- File storage ---
# "local" for development, "s3" for production (or any S3-compatible provider).
STORAGE_PROVIDER="local"

# Used when STORAGE_PROVIDER=local. Kept outside the app's source tree.
STORAGE_LOCAL_PATH="../tunify-storage"

# Used when STORAGE_PROVIDER=s3. Works with AWS S3 or any S3-compatible
# service (Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces, etc).
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Only needed for non-AWS S3-compatible endpoints, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=""

# --- Uploads ---
# Maximum allowed release file size. Accepts values like "500MB" or "2GB".
MAX_UPLOAD_SIZE="500MB"

NODE_ENV="development"
